# Build output and collected artifacts are regenerated by the pipeline.
/out/
/artifacts/
__pycache__/
*.pyc

# Debian image build (nabu-main/debian): regenerated trees and input debs.
/debian/work/
/debian/out/
/debian/packages/*.deb

# Kernel packages built by "make deb-kernel" land in the repo root.
/*.deb
/*.changes
/*.buildinfo

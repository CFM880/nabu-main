# SPDX-License-Identifier: GPL-2.0-only
# Shared kernel debug options for the nabu products.
#
# These used to live in nabu-power/config/nabu-power.config by accident (next
# to the charger drivers), so a product that dropped nabu-power also dropped
# CONFIG_DYNAMIC_DEBUG and then the rootfs modules built against it failed to
# load ("usbhid: Unknown symbol __dynamic_pr_debug", ipv6, fuse, ...).
# Keep them independent of any one module.
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DYNAMIC_DEBUG_CORE=y
